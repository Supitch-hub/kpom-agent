{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "art-ai",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB", "database_name": "art-ai",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["* * * * *", "30 1 * * *"] },
  "vars": {
    "RESPONSE_MODE": "echo",
    "TIMEZONE": "Asia/Bangkok", "DAILY_BRIEFING_TIME": "08:30",
    "MAX_MONTHLY_PUSH_MESSAGES": "250", "GEMINI_MODEL": "gemini-2.5-flash-lite",
    "AI_ENABLED": "false", "MOCK_CLIENTS": "false"
  },
  "observability": { "enabled": false }
}
