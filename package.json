{
  "name": "art-ai-line-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:echo": "wrangler dev --config wrangler.echo.jsonc",
    "deploy:echo": "wrangler deploy --config wrangler.echo.jsonc",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply art-ai --local",
    "db:remote": "wrangler d1 migrations apply art-ai --remote"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.155.0",
    "@cloudflare/vitest-plugin": "1.4.10"
  }
}
